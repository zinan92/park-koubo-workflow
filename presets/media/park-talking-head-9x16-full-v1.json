{
  "schema_version": "ask-park-video/media-preset/v1",
  "id": "park-talking-head-9x16-full-v1",
  "status": "override",
  "selected_by": "project.json spec.layout = vertical-full-overlay（Park 在 content-studio 剪辑进度里手动选）",
  "video": {
    "width": 1080,
    "height": 1920,
    "aspect_ratio": "9:16",
    "fps": 30,
    "codec": "h264",
    "encoder": "libx264",
    "preset": "medium",
    "crf": 18,
    "pixel_format": "yuv420p",
    "gop_frames": 60,
    "color_primaries": "bt709",
    "color_transfer": "bt709",
    "color_space": "bt709"
  },
  "audio": {
    "codec": "aac",
    "sample_rate_hz": 48000,
    "channels": 2,
    "bitrate_kbps": 192
  },
  "layout": {
    "mode": "full-face-overlay",
    "face_live": true,
    "note": "人脸全屏保留，动效只做胸前卡片（版式 C）。4K 竖屏素材先缩到 1080×1920 再叠加。",
    "card_zone": {"x": 60, "width": 840, "bottom": 1580},
    "keep_clear": [
      {"what": "头部", "measure": "每个项目抽 10–20 帧实测；2026-09-28 实测头部占画面高 18–59%"},
      {"what": "剪映字幕带", "y_pct": [0.83, 0.92]},
      {"what": "抖音右侧按钮栏", "x_min": 900, "y_pct": [0.35, 0.80]}
    ],
    "visual_style": "park-card-overlay-c-v1"
  },
  "concatenate_match_fields": [
    "width", "height", "fps", "codec", "pixel_format",
    "color_primaries", "color_transfer", "color_space",
    "audio.codec", "audio.sample_rate_hz", "audio.channels"
  ],
  "on_aspect_ratio_mismatch": "blocked_missing_media_and_caption_preset"
}
